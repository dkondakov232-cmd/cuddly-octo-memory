(function particles(){if(reduced)return;const c=$('#ambient'),ctx=c.getContext('2d');if(!ctx)return;let w,h,particles=[],pointer={x:-1000,y:-1000},running=true;function resize(){w=c.width=innerWidth;h=c.height=innerHeight;let n=Math.min(60,Math.floor(w*h/22000));particles=Array.from({length:n},()=>({x:Math.random()*w,y:Math.random()*h,r:.7+Math.random()*1.6,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3}))}resize();addEventListener('resize',resize,{passive:true});addEventListener('pointermove',e=>{pointer.x=e.clientX;pointer.y=e.clientY},{passive:true});document.addEventListener('visibilitychange',()=>{running=!document.hidden;if(running)requestAnimationFrame(draw)});function draw(){if(!running)return;ctx.clearRect(0,0,w,h);for(const p of particles){let dx=p.x-pointer.x,dy=p.y-pointer.y,dist=dx*dx+dy*dy;if(dist<13000&&dist>100){p.x+=dx/Math.sqrt(dist)*.6;p.y+=dy/Math.sqrt(dist)*.6}p.x=(p.x+p.vx+w)%w;p.y=(p.y+p.vy+h)%h;ctx.fillStyle='rgba(175,155,255,.42)';ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill()}requestAnimationFrame(draw)}draw()})();
