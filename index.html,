const CONFIG = {
  BOT_NAME: 'KST Connect',
  BOT_URL: '', // ОБЯЗАТЕЛЬНО укажи свою ссылку перед публикацией
  COUNT: 0,
  GOAL: 40,
  COLORS: { pink:'#ff4dba', purple:'#8b5cf6', cyan:'#4ce8ff' },
  SCREENSHOTS: [
    {title:'Добро пожаловать', caption:'Первый экран и знакомство с ботом', image:''},
    {title:'Твоя анкета', caption:'Имя, интересы и описание', image:''},
    {title:'Лента знакомств', caption:'Выбирай тех, с кем хочется общаться', image:''},
    {title:'Взаимный лайк', caption:'Общение начинается по взаимному интересу', image:''}
  ]
};
// ---------------------- ЛОГИКА САЙТА ----------------------
const $=s=>document.querySelector(s), $$=s=>Array.from(document.querySelectorAll(s));
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
let sound=false, audioCtx;let toastTimeout;
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimeout);toastTimeout=setTimeout(()=>t.classList.remove('show'),3300)}
function clickSound(){if(!sound)return;try{audioCtx??=new (window.AudioContext||window.webkitAudioContext)();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.setValueAtTime(650,audioCtx.currentTime);o.frequency.exponentialRampToValueAtTime(380,audioCtx.currentTime+.07);g.gain.setValueAtTime(.035,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+.08);o.connect(g).connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.08)}catch(e){}}
function buzz(){if(!reduced&&navigator.vibrate)navigator.vibrate(20)}
$$('button').forEach(b=>b.addEventListener('click',()=>{clickSound();buzz()}));
$('#soundToggle').addEventListener('click',()=>{sound=!sound;$('#soundToggle').textContent=sound?'♫':'♪';$('#soundToggle').title=sound?'Выключить звук':'Включить звук';$('#soundToggle').setAttribute('aria-label',sound?'Выключить звук':'Включить звук');toast(sound?'Звук включён':'Звук выключен')});
$$('[data-name]').forEach(n=>n.textContent=CONFIG.BOT_NAME);document.title=CONFIG.BOT_NAME+' — знакомиться проще, чем кажется';$('#introName').textContent=CONFIG.BOT_NAME.toUpperCase();
function validBotUrl(){try{let u=new URL(CONFIG.BOT_URL);return u.protocol==='https:'&&u.hostname==='t.me'&&u.pathname.length>1}catch{return false}}
$$('.bot-link').forEach(a=>{if(validBotUrl()){a.href=CONFIG.BOT_URL;a.target='_blank';a.rel='noopener noreferrer'}else{a.href='#';a.addEventListener('click',e=>{e.preventDefault();toast('Добавь BOT_URL в настройках HTML — ссылка пока не указана')})}});
const count=Math.max(0,Math.min(CONFIG.GOAL,Number(CONFIG.COUNT)||0)),pct=Math.round(count/CONFIG.GOAL*100);
$$('[data-progress]').forEach(p=>{p.querySelector('.count-num').textContent=count;p.querySelector('.progress-percent').textContent=pct+'%';p.querySelector('.progress-state').textContent=count>=CONFIG.GOAL?'✦ Проект открыт!':'● Идёт набор';requestAnimationFrame(()=>setTimeout(()=>p.querySelector('.liquid-fill').style.width=pct+'%',reduced?0:500))});
function celebrate(){const c=$('#confetti'),ctx=c.getContext('2d');if(!ctx||reduced)return;const w=c.width=innerWidth,h=c.height=innerHeight;let pieces=Array.from({length:110},()=>({x:Math.random()*w,y:-Math.random()*h,v:2+Math.random()*4,s:3+Math.random()*5,r:Math.random()*6,color:[CONFIG.COLORS.pink,CONFIG.COLORS.cyan,CONFIG.COLORS.purple,'#bcff75'][Math.floor(Math.random()*4)]}));let frame=0;function draw(){ctx.clearRect(0,0,w,h);pieces.forEach(p=>{p.y+=p.v;p.x+=Math.sin(frame*.03+p.r)*.8;ctx.fillStyle=p.color;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(frame*.03+p.r);ctx.fillRect(-p.s/2,-p.s/2,p.s,p.s*1.8);ctx.restore()});if(frame++<230)requestAnimationFrame(draw);else ctx.clearRect(0,0,w,h)}draw()}
