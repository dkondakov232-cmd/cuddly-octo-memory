let heartScore=0,heartBest=0,heartInterval,heartTimeout,heartRunning=false;try{heartBest=Number(localStorage.getItem('kstHeartBest'))||0}catch{}$('#heartBest').textContent=heartBest;function stopHearts(){heartRunning=false;clearInterval(heartInterval);clearTimeout(heartTimeout);$('#heartStart').disabled=false;$('#heartStart').textContent='Сыграть ещё ↻';$('#heartTimer').textContent='Готово';$('#heartArea').replaceChildren();toast('Игра окончена! Очки: '+heartScore)}function spawnHeart(){const h=document.createElement('button');h.className='fall-heart';h.textContent='💗';h.style.left=(5+Math.random()*85)+'%';h.style.top='-35px';h.setAttribute('aria-label','Поймать сердечко');h.onclick=()=>{if(!heartRunning)return;heartScore++;$('#heartScore').textContent=heartScore;h.remove();if(heartScore>heartBest){heartBest=heartScore;$('#heartBest').textContent=heartBest;try{localStorage.setItem('kstHeartBest',heartBest)}catch{}}};$('#heartArea').append(h);setTimeout(()=>h.remove(),2250)}$('#heartStart').onclick=()=>{if(heartRunning)return;heartRunning=true;heartScore=0;$('#heartScore').textContent='0';$('#heartStart').disabled=true;$('#heartArea').replaceChildren();let sec=15;$('#heartTimer').textContent=sec+' с';spawnHeart();heartInterval=setInterval(spawnHeart,430);heartTimeout=setInterval(()=>{sec--;$('#heartTimer').textContent=sec+' с';if(sec<=0){clearInterval(heartTimeout);stopHearts()}},1000)};
